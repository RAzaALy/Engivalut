---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Card from "../../components/Card.astro";
import StatusBadge from "../../components/badges/StatusBadge.astro";
import TagList from "../../components/TagList.astro";
import EmptyState from "../../components/EmptyState.astro";

const { entries: adrs } = await getEmDashCollection("adrs", {
	orderBy: { published_at: "desc" },
});

const tagsByEntry = await getTermsForEntries(
	"adrs",
	adrs.map((a) => a.data.id),
	"tag",
);

function formatDate(date: string | Date | null | undefined) {
	if (!date) return null;
	return new Date(date).toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}
---

<Base
	title="Architecture Decisions"
	description="Architecture Decision Records: the context, decision, and consequences behind each technical choice."
>
	<div class="container page">
		<PageHeader
			eyebrow="Knowledge Base"
			title="Architecture Decisions"
			description="The context, decision, and consequences behind every significant technical choice."
		/>

		{
			adrs.length === 0 ? (
				<EmptyState
					title="No ADRs recorded yet"
					description="Architecture decisions will appear here once published."
				/>
			) : (
				<ol class="adr-list">
					{adrs.map((adr) => (
						<li>
							<Card href={`/adrs/${adr.id}`}>
								<StatusBadge slot="eyebrow" status={adr.data.decision_status} />
								<Fragment slot="title">{adr.data.title}</Fragment>
								<span slot="meta">
									{adr.data.author && <span>{adr.data.author}</span>}
									{formatDate(adr.data.date) && <span>· {formatDate(adr.data.date)}</span>}
								</span>
								<TagList slot="footer" tags={tagsByEntry.get(adr.data.id) ?? []} />
							</Card>
						</li>
					))}
				</ol>
			)
		}
	</div>
</Base>

<style>
	.page {
		padding-block: var(--spacing-12) var(--spacing-24);
	}

	.adr-list {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-6);
	}

	@media (max-width: 720px) {
		.adr-list {
			grid-template-columns: 1fr;
		}
	}
</style>
