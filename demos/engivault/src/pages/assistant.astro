---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import EmptyState from "../components/EmptyState.astro";
import Button from "../components/Button.astro";
---

<Base
	title="Ask Engineering AI"
	description="Ask questions over EngiVault's articles, architecture decisions, and incident reports."
>
	<div class="container page">
		<PageHeader
			eyebrow="Engineering Knowledge Intelligence"
			title="Ask Engineering AI"
			description="A grounded assistant that answers from EngiVault's own articles, ADRs, and incident reports — with citations back to the source."
		/>

		<EmptyState
			title="Coming soon"
			description="The AI assistant isn't wired up yet. In the meantime, search the knowledge base directly."
		>
			<div class="actions">
				<Button href="/search">Search instead</Button>
				<Button href="/knowledge" variant="secondary">Explore Knowledge</Button>
			</div>
		</EmptyState>
	</div>
</Base>

<style>
	.page {
		padding-block: var(--spacing-12) var(--spacing-24);
	}

	.actions {
		display: flex;
		gap: var(--spacing-3);
		margin-top: var(--spacing-6);
	}

	@media (max-width: 480px) {
		.actions {
			flex-direction: column;
			width: 100%;
		}
	}
</style>
