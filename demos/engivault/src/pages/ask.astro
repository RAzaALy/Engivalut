---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import AskAssistant from "../components/AskAssistant";
import { canonicalUrl } from "../utils/seo";
---

<Base
	title="Engineering AI"
	description="Ask questions about EngiVault's engineering knowledge base — grounded answers with citations to the source articles, ADRs, and incident reports."
	canonical={canonicalUrl(Astro.url)}
>
	<div class="container page">
		<PageHeader
			eyebrow="Engineering Knowledge Intelligence"
			title="Engineering AI"
			description="Ask questions about our engineering knowledge base."
		/>
		<AskAssistant client:idle />
	</div>
</Base>

<style>
	.page {
		padding-block: var(--spacing-12) var(--spacing-24);
	}
</style>
