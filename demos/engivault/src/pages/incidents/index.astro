---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Card from "../../components/Card.astro";
import SeverityBadge from "../../components/badges/SeverityBadge.astro";
import IncidentStatusBadge from "../../components/badges/IncidentStatusBadge.astro";
import TagList from "../../components/TagList.astro";
import EmptyState from "../../components/EmptyState.astro";
import ErrorState from "../../components/ErrorState.astro";
import { canonicalUrl } from "../../utils/seo";

let loadError: Error | null = null;
let incidents: Awaited<ReturnType<typeof getEmDashCollection<"incidents">>>["entries"] = [];
let tagsByEntry = new Map<string, Array<{ slug: string; label: string }>>();

try {
	const result = await getEmDashCollection("incidents", {
		orderBy: { published_at: "desc" },
	});
	incidents = result.entries;
	if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);

	tagsByEntry = await getTermsForEntries(
		"incidents",
		incidents.map((i) => i.data.id),
		"tag",
	);
} catch (error) {
	loadError = error instanceof Error ? error : new Error(String(error));
	Astro.response.status = 500;
}

function formatDate(date: string | Date | null | undefined) {
	if (!date) return null;
	return new Date(date).toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}
---

<Base
	title="Incident Reports"
	description="Postmortems: severity, root cause, resolution, and lessons learned."
	canonical={canonicalUrl(Astro.url)}
	robots={loadError ? "noindex, nofollow" : undefined}
>
	<div class="container page">
		<PageHeader
			eyebrow="Knowledge Base"
			title="Incident Reports"
			description="Severity, root cause, resolution, and lessons learned for every recorded incident."
		/>

		{
			loadError ? (
				<ErrorState
					code="500"
					title="Couldn't load incident reports"
					description="Something went wrong fetching the knowledge base. Please try again shortly."
				/>
			) : incidents.length === 0 ? (
				<EmptyState
					title="No incidents recorded"
					description="Incident reports will appear here once published."
				/>
			) : (
				<ol class="incident-list">
					{incidents.map((incident) => (
						<li>
							<Card href={`/incidents/${incident.id}`} headingLevel="h2">
								<span slot="eyebrow">
									<SeverityBadge severity={incident.data.severity} />
									<IncidentStatusBadge status={incident.data.incident_status} />
								</span>
								<Fragment slot="title">{incident.data.title}</Fragment>
								<span slot="meta">
									{formatDate(incident.data.date) && <time>{formatDate(incident.data.date)}</time>}
								</span>
								{incident.data.summary}
								<TagList slot="footer" tags={tagsByEntry.get(incident.data.id) ?? []} />
							</Card>
						</li>
					))}
				</ol>
			)
		}
	</div>
</Base>

<style>
	.page {
		padding-block: var(--spacing-12) var(--spacing-24);
	}

	.incident-list {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-6);
	}

	@media (max-width: 720px) {
		.incident-list {
			grid-template-columns: 1fr;
		}
	}
</style>
