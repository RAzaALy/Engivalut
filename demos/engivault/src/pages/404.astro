---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import ErrorState from "../components/ErrorState.astro";

// Served both for truly unmatched routes (where Astro applies 404 itself)
// and via Astro.rewrite("/404") from invalid-slug detail pages, which
// otherwise wouldn't get a 404 status — a real status code, not just
// wording, is what keeps a crawler from indexing this as if it were content.
Astro.response.status = 404;
---

<Base title="Page not found" robots="noindex, follow">
	<div class="container page">
		<ErrorState
			code="404"
			title="Page not found"
			description="The page you're looking for doesn't exist or may have been moved."
		>
			<div class="actions">
				<Button href="/">Go home</Button>
				<Button href="/search" variant="secondary">Search instead</Button>
			</div>
		</ErrorState>
	</div>
</Base>

<style>
	.page {
		display: flex;
		justify-content: center;
		padding-block: var(--spacing-24);
	}

	.actions {
		display: flex;
		gap: var(--spacing-3);
		margin-top: var(--spacing-6);
	}
</style>
