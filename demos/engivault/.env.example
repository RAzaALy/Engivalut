# LLM provider for the Engineering AI Assistant (/api/ask).
# Any OpenAI-compatible chat/completions provider works — set LLM_BASE_URL
# and LLM_MODEL to switch (Gemini, Groq, OpenRouter, xAI, etc). Defaults to
# Google's Gemini OpenAI-compatibility endpoint if left unset.
# Get a free key at https://aistudio.google.com
#
# Never commit the real value — this file only documents the variable names.
LLM_API_KEY=

# Optional overrides:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.6-flash
